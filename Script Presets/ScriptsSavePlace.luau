-- CompleteSavePlace / ScriptsSavePlace
-- Authorized script-focused export with per-job decompilation and bytecode timeouts.
-- Status: runtime-unverified. Generated by scripts/generate_presets.py; edit presets.json.
-- License: AGPL-3.0. See LICENSE and NOTICE.md for upstream attribution.

-- Relative to the runtime's file workspace, not the Git checkout on your PC.
local CORE_PATH = "CompleteSavePlace/saveinstance.luau"
local USE_LOCAL_CORE = false -- opt in explicitly when developing a local engine
local CORE_URL = "https://raw.githubusercontent.com/g0shtj0sh/CompleteSavePlace/v0.6.4/saveinstance.luau"
local PRESET_ID = "ScriptsSavePlace"
local options = {
	mode = "scripts",
	Binary = true,
	CompressionMode = "lz4",
	Decompile = true,
	DecompileTimeout = 10,
	SaveBytecode = true,
	BytecodeTimeout = 3,
	IgnorePropertiesOfNotScriptsOnScriptsMode = true,
	NilInstances = false,
	IgnoreSpecialProperties = true,
	IgnoreDefaultPlayerScripts = true,
	AlternativeWritefile = false,
	SafeMode = false,
	KillAllScripts = false,
	BoostFPS = false,
	ShutdownWhenDone = false,
	ShowStatus = true,
	__DEBUG_MODE = true,
	WorkBudgetMs = 4,
}

local prefix = "[CSP / " .. PRESET_ID .. "] "
local function fail(message)
	error(prefix .. message, 0)
end

if type(readfile) ~= "function" or type(writefile) ~= "function" or type(loadstring) ~= "function" then
	fail("This preset requires readfile, writefile, and loadstring. Use a compatible local runtime.")
end
if type(makefolder) ~= "function" or type(isfolder) ~= "function" then
	fail("This preset requires makefolder and isfolder to group each export in its own folder.")
end

local function cleanName(value, maxBytes)
	-- Retain Unicode; replace only path separators, control characters and Windows-invalid characters.
	value = string.gsub(value, '[<>:"/\\|?*%c]', " ")
	value = string.gsub(value, "%s+", " ")
	value = string.gsub(value, "^ +", "")
	if #value > maxBytes then
		local boundary = maxBytes + 1
		while boundary > 1 do
			local byte = string.byte(value, boundary)
			if byte < 128 or byte >= 192 then break end
			boundary -= 1
		end
		value = string.sub(value, 1, boundary - 1)
	end
	return string.gsub(value, "[%. ]+$", "")
end

local placeName
for _, method in { "GetProductInfoAsync", "GetProductInfo" } do
	local nameOk, info = pcall(function()
		local marketplace = game:GetService("MarketplaceService")
		return marketplace[method](marketplace, game.PlaceId)
	end)
	if nameOk and type(info) == "table" and type(info.Name) == "string" and info.Name ~= "" then
		placeName = info.Name
		break
	end
end
if not placeName then
	local nameOk, name = pcall(function() return game.Name end)
	if nameOk and type(name) == "string" and name ~= "Game" and name ~= "Place" then
		placeName = name
	end
end
local titleBudget = 80 - #PRESET_ID - 3
local title = cleanName(placeName or "", titleBudget)
if title == "" then title = "Place " .. tostring(game.PlaceId) end
local baseName = title .. " - " .. PRESET_ID
local outputFolder, outputName
for attempt = 1, 9999 do
	local candidate = baseName .. (attempt == 1 and "" or " (" .. tostring(attempt) .. ")")
	local checked, exists = pcall(isfolder, candidate)
	if not checked or type(exists) ~= "boolean" then fail("Could not check output folder: " .. candidate) end
	if not exists and type(isfile) == "function" then
		local fileChecked, fileExists = pcall(isfile, candidate)
		if not fileChecked then fail("Could not check output path: " .. candidate) end
		exists = fileExists
	end
	if not exists then
		local created, createError = pcall(makefolder, candidate)
		if not created then fail("Could not create output folder: " .. tostring(createError)) end
		local verified, folderExists = pcall(isfolder, candidate)
		if not verified or folderExists ~= true then fail("Output folder was not created: " .. candidate) end
		outputFolder, outputName = candidate, title
		break
	end
end
if not outputFolder then fail("No available output folder name; archive or move older exports.") end
options.FilePath = outputFolder .. "/" .. outputName .. ".rbxl"

local runId = tostring(game.PlaceId) .. "_" .. tostring(os.time()) .. "_" .. tostring(math.random(100000, 999999))
local probePath = outputFolder .. "/write-test.tmp"
local marker = "CompleteSavePlace write probe " .. runId
local probeOk, probeError = pcall(function()
	writefile(probePath, marker)
	if readfile(probePath) ~= marker then
		error("Write/read probe content did not match", 0)
	end
end)
if type(delfile) == "function" then
	pcall(delfile, probePath)
end
if not probeOk then
	fail("Basic file probe failed: " .. tostring(probeError))
end

print(prefix .. "Write/read probe passed. Output: " .. options.FilePath)
print(prefix .. "Runtime status: runtime-unverified. Per-job timeouts do not bound the total export duration.")
local started = os.clock()
local exportReport
local sourceOrigin
local sourceBytes
local progressPath = outputFolder .. "/progress.json"
local lastProgressLog, progressWriteFailed = -math.huge, false
local latestProgress
local function onProgress(progress)
	latestProgress = progress
	progress.preset = PRESET_ID
	progress.profile = "Universal"
	progress.wrapperVersion = "0.6.4"
	progress.sourceOrigin = sourceOrigin
	progress.validation = "unverified"
	local wrote, writeError = pcall(function()
		writefile(progressPath, game:GetService("HttpService"):JSONEncode(progress))
	end)
	if not wrote and not progressWriteFailed then
		progressWriteFailed = true
		warn(prefix .. "Could not write progress checkpoint: " .. tostring(writeError))
	end
	if os.clock() - lastProgressLog >= 10 or progress.phase == "completed" or progress.phase == "failed" then
		lastProgressLog = os.clock()
		local detail = progress.detail or {}
		print(prefix .. "Progress: " .. tostring(progress.phase) .. " | " .. tostring(detail.operation or detail.property or "") .. " | " .. tostring(detail.path or detail.class or detail.outputPath or ""))
	end
end
print(prefix .. "Progress checkpoint: " .. progressPath)
local ok, result = xpcall(function()
	local source
	if USE_LOCAL_CORE then
		print(prefix .. "Loading local core: " .. CORE_PATH)
		sourceOrigin = CORE_PATH
		onProgress({ phase = "loading-core" })
		source = readfile(CORE_PATH)
	else
		print(prefix .. "Loading pinned core: " .. CORE_URL)
		sourceOrigin = CORE_URL
		onProgress({ phase = "loading-core" })
		source = game:HttpGet(CORE_URL, true)
	end
	sourceBytes = #source
	print(prefix .. "Core source bytes: " .. tostring(sourceBytes))
	local chunk, compileError = loadstring(source, "CompleteSavePlace")
	if not chunk then
		error("Core compilation failed: " .. tostring(compileError), 0)
	end
	onProgress({ phase = "loading-dependencies" })
	local completeSavePlace = chunk({ onProgress = onProgress })
	if type(completeSavePlace) ~= "function" then
		error("Core did not return an export function", 0)
	end
	exportReport = completeSavePlace(options)
	if type(exportReport) == "table" and exportReport.ok == false then
		error("Engine reported failure: " .. tostring(exportReport.error), 0)
	end
end, function(message)
	if debug and type(debug.traceback) == "function" then
		return debug.traceback(tostring(message), 2)
	end
	return tostring(message)
end)
local report = type(exportReport) == "table" and exportReport or {
	schemaVersion = 1, engineVersion = "unknown", validation = "unverified", ok = ok,
	propertyAudit = "unavailable_from_this_core",
}
report.preset = PRESET_ID
report.wrapperVersion = "0.6.4"
report.profile = "Universal"
report.sourceOrigin = sourceOrigin
report.sourceBytes = sourceBytes
report.progressPath = progressPath
report.outputFolder = outputFolder
report.placeName = placeName or title
report.lastProgress = report.lastProgress or latestProgress
report.wrapperError = not ok and tostring(result) or nil
report.outputPath = report.outputPath or options.FilePath
local existenceChecked, outputExists
if type(isfile) == "function" then
	existenceChecked, outputExists = pcall(isfile, report.outputPath)
	if existenceChecked then
		report.outputExists = outputExists
	else
		report.outputExistenceError = tostring(outputExists)
	end
else
	report.outputExistenceError = "isfile_unavailable"
end
local reportPath = outputFolder .. "/report.json"
local reportOk, reportError = pcall(function()
	local json = game:GetService("HttpService"):JSONEncode(report)
	writefile(reportPath, json)
end)
if reportOk then
	print(prefix .. "Diagnostic report: " .. reportPath)
else
	warn(prefix .. "Could not write diagnostic report: " .. tostring(reportError))
end
if report.criticalGeometryOmissions and report.criticalGeometryOmissions > 0 then
	warn(prefix .. tostring(report.criticalGeometryOmissions) .. " geometry/terrain property columns were omitted. See the report; missing road geometry is not repaired by a completed export.")
end
if report.engineVersion ~= "0.6.4" then
	warn(prefix .. "Selected core version: " .. tostring(report.engineVersion) .. "; expected 0.6.4. Check for an outdated local CORE_PATH.")
end
if not ok then
	fail("Export failed. Check CORE_PATH and console details: " .. tostring(result))
end

print(prefix .. string.format("Export function returned after %.2fs; file validity is unverified.", os.clock() - started))
if type(isfile) == "function" then
	if existenceChecked and outputExists then
		print(prefix .. "Output exists: " .. report.outputPath .. ". Open and inspect it in Roblox Studio.")
	elseif existenceChecked then
		warn(prefix .. "Output not found: " .. report.outputPath .. ". Do not treat this run as a successful backup.")
	else
		warn(prefix .. "Output existence check failed: " .. tostring(outputExists))
	end
else
	warn(prefix .. "isfile is unavailable; output existence remains unverified.")
end
